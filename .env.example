POSTGRES_USER=reposage
POSTGRES_PASSWORD=reposage
POSTGRES_DB=reposage
DATABASE_URL=postgresql+psycopg://reposage:reposage@postgres:5432/reposage
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==============================================================================
# MULTI-PROVIDER LLM CONFIGURATION
# Choose ANY of the options below (no vendor lock-in!):
# ==============================================================================

# OPTION 1: Google Gemini (Free tier available on Google AI Studio)
# GEMINI_API_KEY=AIzaSy... (or AQ....)
# GEMINI_MODEL=gemini-flash-latest

# OPTION 2: Groq (Ultra-fast, generous free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=gemma2-9b-it

# OPTION 3: OpenRouter (Access 200+ models including free options)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPTION 4: DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# OPTION 5: Ollama (100% Free & Local, no API key required)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3

# OPTION 6: OpenAI
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# OPTION 7: Any custom OpenAI-compatible endpoint (vLLM, LM Studio, LiteLLM)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=optional
# LLM_MODEL=local-model
